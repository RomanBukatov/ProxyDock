<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <ResourceDictionary.ThemeDictionaries>
    <ResourceDictionary x:Key="Dark">
      <SolidColorBrush x:Key="AppCanvasBrush" Color="#0E1218" />
      <SolidColorBrush x:Key="HeaderSurfaceBrush" Color="#131821" />
      <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#131821" />
      <SolidColorBrush x:Key="CardSurfaceBrush" Color="#171E29" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#1D2634" />
      <SolidColorBrush x:Key="CardPressedBrush" Color="#141A24" />
      <SolidColorBrush x:Key="RowHoverBrush" Color="#1D2634" />
      <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#1F2838" />
      <SolidColorBrush x:Key="NavTrackBrush" Color="#0D1117" />
      <SolidColorBrush x:Key="NavSelectedBrush" Color="#212B3C" />
      <SolidColorBrush x:Key="IconFrameBrush" Color="#11161F" />
      <SolidColorBrush x:Key="IconFrameBorderBrush" Color="#242E40" />
      <SolidColorBrush x:Key="InputSurfaceBrush" Color="#11161F" />
      <SolidColorBrush x:Key="BorderSubtleBrush" Color="#242E40" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#394964" />

      <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#5393F8" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="AccentTextOnFillBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#192B48" />
      <SolidColorBrush x:Key="AccentBorderBrush" Color="#2A4A7C" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F2F6FC" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A7B4CA" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#77869E" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#6F7E96" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#8897AF" />

      <SolidColorBrush x:Key="SuccessBrush" Color="#34D399" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#122D25" />
      <SolidColorBrush x:Key="WarningBrush" Color="#FBBF24" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#332712" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
      <SolidColorBrush x:Key="ErrorSoftBrush" Color="#35191F" />
      <SolidColorBrush x:Key="InfoBrush" Color="#60A5FA" />
      <SolidColorBrush x:Key="InfoSoftBrush" Color="#172A45" />
    </ResourceDictionary>

    <ResourceDictionary x:Key="Light">
      <SolidColorBrush x:Key="AppCanvasBrush" Color="#F3F5F9" />
      <SolidColorBrush x:Key="HeaderSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="SidebarSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="CardHoverBrush" Color="#FAFBFD" />
      <SolidColorBrush x:Key="CardPressedBrush" Color="#EEF2F8" />
      <SolidColorBrush x:Key="RowHoverBrush" Color="#F4F7FC" />
      <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="#EDF1F7" />
      <SolidColorBrush x:Key="NavTrackBrush" Color="#EEF2F7" />
      <SolidColorBrush x:Key="NavSelectedBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="IconFrameBrush" Color="#F5F7FC" />
      <SolidColorBrush x:Key="IconFrameBorderBrush" Color="#E4EAF3" />
      <SolidColorBrush x:Key="InputSurfaceBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="BorderSubtleBrush" Color="#E1E7F0" />
      <SolidColorBrush x:Key="BorderStrongBrush" Color="#BDC8DC" />

      <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
      <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
      <SolidColorBrush x:Key="AccentTextOnFillBrush" Color="#FFFFFF" />
      <SolidColorBrush x:Key="AccentSoftBrush" Color="#EBF2FF" />
      <SolidColorBrush x:Key="AccentBorderBrush" Color="#BFDBFE" />

      <SolidColorBrush x:Key="TextPrimaryBrush" Color="#111827" />
      <SolidColorBrush x:Key="TextSecondaryBrush" Color="#4B5565" />
      <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7688" />
      <SolidColorBrush x:Key="TextControlPlaceholderForeground" Color="#7A8599" />
      <SolidColorBrush x:Key="TextControlPlaceholderForegroundFocused" Color="#5A6578" />

      <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
      <SolidColorBrush x:Key="SuccessSoftBrush" Color="#E6F6EF" />
      <SolidColorBrush x:Key="WarningBrush" Color="#B45309" />
      <SolidColorBrush x:Key="WarningSoftBrush" Color="#FEF3C7" />
      <SolidColorBrush x:Key="ErrorBrush" Color="#DC2626" />
      <SolidColorBrush x:Key="ErrorSoftBrush" Color="#FEE2E2" />
      <SolidColorBrush x:Key="InfoBrush" Color="#2563EB" />
      <SolidColorBrush x:Key="InfoSoftBrush" Color="#EBF2FF" />
    </ResourceDictionary>
  </ResourceDictionary.ThemeDictionaries>
</ResourceDictionary>
