<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProxyDock.App.ViewModels"
        x:Class="ProxyDock.App.Views.ConfirmationDialog"
        x:DataType="vm:ConfirmationDialogViewModel"
        Title="{Binding Title}"
        Icon="avares://ProxyDock/Assets/proxydock.ico"
        Width="440"
        MaxWidth="460"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
  <Border Padding="20" Background="{DynamicResource AppCanvasBrush}">
    <StackPanel Spacing="14">
      <TextBlock Text="{Binding Title}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
      <ScrollViewer MaxHeight="360" HorizontalScrollBarVisibility="Disabled">
        <TextBlock Text="{Binding Message}"
                   Foreground="{DynamicResource TextSecondaryBrush}"
                   TextWrapping="Wrap"
                   LineHeight="19" />
      </ScrollViewer>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8" Margin="0,4,0,0">
        <Button Content="{Binding CancelText}"
                Classes="secondary"
                IsVisible="{Binding ShowCancel}"
                Command="{Binding CancelCommand}" />
        <Button Content="{Binding ConfirmText}"
                Classes="danger"
                IsVisible="{Binding IsDanger}"
                Command="{Binding ConfirmCommand}" />
        <Button Content="{Binding ConfirmText}"
                Classes="primary"
                IsVisible="{Binding !IsDanger}"
                Command="{Binding ConfirmCommand}" />
      </StackPanel>
    </StackPanel>
  </Border>
</Window>
