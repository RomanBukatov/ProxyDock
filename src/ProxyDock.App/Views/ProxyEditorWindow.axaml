<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProxyDock.App.ViewModels"
        x:Class="ProxyDock.App.Views.ProxyEditorWindow"
        x:DataType="vm:ProxyEditorViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://ProxyDock/Assets/proxydock.ico"
        Width="520"
        Height="560"
        MinWidth="440"
        MinHeight="420"
        WindowStartupLocation="CenterOwner"
        CanResize="True">
  <DockPanel Background="{DynamicResource AppCanvasBrush}">
    <Border DockPanel.Dock="Bottom"
            Padding="18,12"
            Background="{DynamicResource HeaderSurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
        <Button Content="Отмена" Classes="secondary" Command="{Binding CancelCommand}" />
        <Button Content="Сохранить прокси" Classes="primary" Command="{Binding SaveCommand}" />
      </StackPanel>
    </Border>

    <ScrollViewer Padding="20,16" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding WindowTitle}" Classes="page-title" />

        <Border Classes="card"
                Padding="10,8"
                Background="{DynamicResource InfoSoftBrush}"
                BorderBrush="{DynamicResource InfoBrush}">
          <TextBlock Text="Пароль прокси не хранится в JSON и не отображается в интерфейсе. Он защищается через Windows DPAPI (CurrentUser)."
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </Border>

        <StackPanel Spacing="5">
          <TextBlock Text="Название профиля *" FontWeight="Medium" />
          <TextBox Text="{Binding Name}" PlaceholderText="Например: Proxy A — Основной" />
        </StackPanel>

        <Grid ColumnDefinitions="*,120" ColumnSpacing="10">
          <StackPanel Spacing="5">
            <TextBlock Text="Host / IP *" FontWeight="Medium" />
            <TextBox Text="{Binding Host}" PlaceholderText="127.0.0.1 или proxy.example.com" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="Port *" FontWeight="Medium" />
            <NumericUpDown Value="{Binding Port}" Minimum="1" Maximum="65535" Increment="1" FormatString="0" />
          </StackPanel>
        </Grid>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
          <StackPanel Spacing="5">
            <TextBlock Text="Имя пользователя (опционально)" FontWeight="Medium" />
            <TextBox Text="{Binding Username}" PlaceholderText="Логин для прокси" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="Новый пароль (опционально)" FontWeight="Medium" />
            <TextBox Text="{Binding Password}" PasswordChar="•" PlaceholderText="Не менять, если пусто" />
          </StackPanel>
        </Grid>

        <Border Classes="card" Padding="10,8" IsVisible="{Binding HasSavedPassword}">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
            <TextBlock Text="Пароль уже сохранён в хранилище DPAPI."
                       Foreground="{DynamicResource SuccessBrush}"
                       VerticalAlignment="Center"
                       FontSize="12" />
            <CheckBox Grid.Column="1"
                      Content="Удалить пароль"
                      IsChecked="{Binding ClearSavedPassword}" />
          </Grid>
        </Border>

        <StackPanel Spacing="5">
          <TextBlock Text="NO_PROXY (исключения через запятую)" FontWeight="Medium" />
          <TextBox Text="{Binding NoProxy}" PlaceholderText="localhost,127.0.0.1,::1" />
        </StackPanel>

        <Grid ColumnDefinitions="150,*" ColumnSpacing="10">
          <StackPanel Spacing="5">
            <TextBlock Text="Таймаут (сек)" FontWeight="Medium" />
            <NumericUpDown Value="{Binding CheckTimeoutSeconds}" Minimum="1" Maximum="120" Increment="1" FormatString="0" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="URL для HTTPS-диагностики" FontWeight="Medium" />
            <TextBox Text="{Binding DiagnosticEndpointUrl}" />
          </StackPanel>
        </Grid>

        <CheckBox Content="Сделать этот прокси профилем по умолчанию"
                  IsChecked="{Binding IsDefault}" />

        <Border Classes="card"
                Background="{DynamicResource ErrorSoftBrush}"
                BorderBrush="{DynamicResource ErrorBrush}"
                IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ValidationError}"
                     Foreground="{DynamicResource ErrorBrush}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
