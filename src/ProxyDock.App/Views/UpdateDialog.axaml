<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProxyDock.App.ViewModels"
        x:Class="ProxyDock.App.Views.UpdateDialog"
        x:DataType="vm:UpdateDialogViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://ProxyDock/Assets/proxydock.ico"
        Width="540"
        Height="480"
        MinWidth="440"
        MinHeight="380"
        WindowStartupLocation="CenterOwner">
  <DockPanel Background="{DynamicResource AppCanvasBrush}">
    <Border DockPanel.Dock="Bottom"
            Padding="18,12"
            Background="{DynamicResource HeaderSurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <Button Content="{Binding Loc[UpdateOpenGitHub]}"
                Classes="secondary"
                Command="{Binding OpenReleasePageCommand}" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{Binding Loc[UpdateLater]}"
                  Classes="secondary"
                  Command="{Binding LaterCommand}" />
          <Button Content="{Binding Loc[UpdateNowAndRestart]}"
                  Classes="primary"
                  IsVisible="{Binding CanSelfUpdate}"
                  IsEnabled="{Binding CanStartUpdate}"
                  Command="{Binding UpdateAndRestartCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Padding="20,16" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding WindowTitle}" Classes="page-title" />

        <!-- Версии и размер -->
        <Border Classes="card">
          <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="14" RowSpacing="8">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Loc[UpdateCurrentVersion]}" Classes="caption" />
              <TextBlock Text="{Binding CurrentVersionDisplay}" Classes="mono row-title" />
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="2">
              <TextBlock Text="{Binding Loc[UpdateAvailableVersion]}" Classes="caption" />
              <TextBlock Text="{Binding AvailableVersionDisplay}"
                         Classes="mono row-title"
                         Foreground="{DynamicResource AccentBrush}" />
            </StackPanel>
            <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="6" IsVisible="{Binding HasDownloadSize}">
              <TextBlock Text="{Binding Loc[UpdateDownloadSize]}" Classes="caption" />
              <TextBlock Text="{Binding DownloadSizeDisplay}" Classes="mono caption" Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>
          </Grid>
        </Border>

        <!-- Пояснение для standalone-сборки -->
        <Border Classes="card"
                Padding="11,9"
                Background="{DynamicResource InfoSoftBrush}"
                BorderBrush="{DynamicResource InfoBrush}"
                IsVisible="{Binding IsStandalone}">
          <TextBlock Text="{Binding Loc[UpdateStandaloneNotice]}"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </Border>

        <!-- Release notes -->
        <StackPanel Spacing="5">
          <TextBlock Text="{Binding Loc[UpdateReleaseNotes]}" Classes="section-title" />
          <Border Classes="card" MaxHeight="200">
            <ScrollViewer HorizontalScrollBarVisibility="Disabled">
              <TextBlock Text="{Binding ReleaseNotesDisplay}"
                         FontSize="12.5"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap"
                         LineHeight="18" />
            </ScrollViewer>
          </Border>
        </StackPanel>

        <!-- Прогресс загрузки -->
        <Border Classes="card" IsVisible="{Binding IsDownloading}">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding DownloadStatusText}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBlock Grid.Column="1"
                         Text="{Binding DownloadPercentage, StringFormat={}{0}%}"
                         Classes="mono"
                         FontSize="12" />
            </Grid>
            <ProgressBar Minimum="0"
                         Maximum="100"
                         Value="{Binding DownloadPercentage}"
                         Height="6" />
          </StackPanel>
        </Border>

        <!-- Ошибка загрузки/установки -->
        <Border Classes="card"
                Background="{DynamicResource ErrorSoftBrush}"
                BorderBrush="{DynamicResource ErrorBrush}"
                IsVisible="{Binding HasError}">
          <TextBlock Text="{Binding ErrorMessage}"
                     FontSize="12"
                     Foreground="{DynamicResource ErrorBrush}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
