<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProxyDock.App.ViewModels"
             x:Class="ProxyDock.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">
  <ScrollViewer Padding="28,24">
    <StackPanel Spacing="22" MaxWidth="1280">
      <!-- Заголовок и быстрые действия -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Loc[DashboardTitle]}" Classes="page-title" />
          <TextBlock Text="{Binding Loc[DashboardDescription]}" Classes="page-desc" />
        </StackPanel>
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="{Binding Loc[BtnAddProxy]}" Classes="secondary" Command="{Binding AddNewProxyCommand}" />
          <Button Content="{Binding Loc[BtnAddApp]}" Classes="primary" Command="{Binding AddNewApplicationCommand}" />
        </StackPanel>
      </Grid>

      <!-- Карточки статистики -->
      <UniformGrid Columns="4" ColumnSpacing="12">
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Loc[StatApps]}" Classes="caption" />
            <TextBlock Text="{Binding ApplicationCount}" FontSize="24" FontWeight="Bold" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Loc[StatProxies]}" Classes="caption" />
            <TextBlock Text="{Binding ProxyCount}" FontSize="24" FontWeight="Bold" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Loc[StatHistory]}" Classes="caption" />
            <TextBlock Text="{Binding HistoryCount}" FontSize="24" FontWeight="Bold" />
          </StackPanel>
        </Border>
        <Border Classes="card">
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding Loc[StatSystemProxy]}" Classes="caption" />
            <TextBlock Text="{Binding Loc[StatSystemProxyValue]}"
                       FontSize="17"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource SuccessBrush}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <!-- Готовые Desktop-профили -->
      <Border Classes="card">
        <StackPanel Spacing="14">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="2">
              <TextBlock Text="{Binding Loc[QuickTemplatesTitle]}" Classes="section-title" />
              <TextBlock Text="{Binding Loc[QuickTemplatesSubtitle]}" Classes="caption" />
            </StackPanel>
            <Button Grid.Column="1"
                    Content="{Binding Loc[AddAllDetected]}"
                    Classes="secondary"
                    VerticalAlignment="Center"
                    Command="{Binding AddAllDetectedDesktopCommand}" />
          </Grid>

          <ItemsControl ItemsSource="{Binding DesktopTemplates}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <UniformGrid Columns="3" ColumnSpacing="12" />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:TemplateCardViewModel">
                <Border Classes="card" Background="{DynamicResource ElevatedSurfaceBrush}" Padding="14">
                  <StackPanel Spacing="8">
                    <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="10">
                      <Border Width="36" Height="36" CornerRadius="8" Background="{DynamicResource CardSurfaceBrush}">
                        <Panel>
                          <Image Source="{Binding Icon}" Width="24" Height="24" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                          <TextBlock Text="GUI" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                     IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}"
                                     Foreground="{DynamicResource AccentBrush}" />
                        </Panel>
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding DetectionText}" Classes="caption" />
                      </StackPanel>
                      <Border Grid.Column="2" Classes="pill" Background="{Binding ApplicabilityBackground}">
                        <TextBlock Text="{Binding ApplicabilityBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ApplicabilityForeground}" />
                      </Border>
                    </Grid>

                    <TextBlock Text="{Binding StackSummary}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" TextWrapping="Wrap" />
                    <TextBlock Text="{Binding PathDisplay}" Classes="mono caption" TextTrimming="CharacterEllipsis" />

                    <Button Content="{Binding AddButtonText}"
                            Classes="secondary"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding AddCommand}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Быстрый запуск добавленных программ -->
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="*,Auto">
          <TextBlock Text="{Binding Loc[QuickLaunchTitle]}" Classes="section-title" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Все приложения →" Classes="subtle" Command="{Binding GoToApplicationsCommand}" />
        </Grid>

        <Border Classes="card" IsVisible="{Binding !HasApps}">
          <StackPanel Spacing="8">
            <TextBlock Text="Пока нет добавленных приложений." FontWeight="SemiBold" />
            <TextBlock Text="Добавьте Google Antigravity Desktop, Claude Desktop, Codex Desktop из блока выше или выберите любой .exe файл."
                       Classes="caption"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <ItemsControl ItemsSource="{Binding QuickLaunchApps}" IsVisible="{Binding HasApps}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="12" LineSpacing="12" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:AppCardViewModel">
              <Border Classes="card card-interactive" Width="375">
                <StackPanel Spacing="10">
                  <Grid ColumnDefinitions="40,*,Auto" ColumnSpacing="10">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource ElevatedSurfaceBrush}">
                      <Panel>
                        <Image Source="{Binding Icon}" Width="26" Height="26" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="APP" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                   IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}"
                                   Foreground="{DynamicResource AccentBrush}" />
                      </Panel>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Name}" Classes="card-title" TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding KindLabel}" Classes="caption" />
                    </StackPanel>
                    <Border Grid.Column="2" Classes="pill" Background="{Binding ApplicabilityBackground}">
                      <TextBlock Text="{Binding ApplicabilityBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ApplicabilityForeground}" />
                    </Border>
                  </Grid>

                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse Width="8" Height="8" Fill="{Binding ProxyStatusDotBrush}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding AssignedProxyLabel}" FontSize="12.5" Foreground="{DynamicResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis" />
                  </StackPanel>

                  <TextBlock Text="Файл/команда не найдена!"
                             IsVisible="{Binding ShowMissingWarning}"
                             FontSize="12"
                             Foreground="{DynamicResource ErrorBrush}" />

                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                    <Button Content="Запустить"
                            Classes="primary"
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Center"
                            Command="{Binding LaunchCommand}" />
                    <Button Grid.Column="1"
                            Content="Без прокси"
                            Classes="secondary"
                            Command="{Binding LaunchDirectCommand}" />
                    <Button Grid.Column="2"
                            Content="⚙"
                            Classes="subtle"
                            Command="{Binding EditCommand}" />
                  </Grid>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>

      <!-- Нижняя панель: Прокси + Последние запуски -->
      <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
        <Border Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Loc[ProxyHealthTitle]}" Classes="section-title" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Управление →" Classes="subtle" Command="{Binding GoToProxiesCommand}" />
            </Grid>

            <TextBlock Text="Нет настроенных прокси. Добавьте HTTP-прокси для запуска программ."
                       Classes="caption"
                       TextWrapping="Wrap"
                       IsVisible="{Binding !HasProxies}" />

            <ItemsControl ItemsSource="{Binding ProxyStatuses}" IsVisible="{Binding HasProxies}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:ProxyCardViewModel">
                  <Border Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="8" Padding="10" Margin="0,4">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <StackPanel>
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding EndpointDisplay}" Classes="mono caption" />
                      </StackPanel>
                      <Border Grid.Column="1" Classes="pill" Background="{Binding StatusBackground}" VerticalAlignment="Center">
                        <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{Binding StatusForeground}" />
                      </Border>
                      <Button Grid.Column="2"
                              Content="{Binding TestButtonText}"
                              Classes="secondary"
                              Padding="10,5"
                              Command="{Binding TestOrCancelCommand}" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Classes="card">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="{Binding Loc[RecentLaunchesTitle]}" Classes="section-title" VerticalAlignment="Center" />
              <Button Grid.Column="1" Content="Вся история →" Classes="subtle" Command="{Binding GoToHistoryCommand}" />
            </Grid>

            <TextBlock Text="История запусков пока пуста."
                       Classes="caption"
                       IsVisible="{Binding !HasHistory}" />

            <ItemsControl ItemsSource="{Binding RecentLaunches}" IsVisible="{Binding HasHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                  <Border Background="{DynamicResource ElevatedSurfaceBrush}" CornerRadius="8" Padding="10" Margin="0,4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                      <StackPanel Spacing="2">
                        <TextBlock Text="{Binding AppName}" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding ProxyLabel}" Classes="caption" TextTrimming="CharacterEllipsis" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" HorizontalAlignment="Right" Spacing="2">
                        <Border Classes="pill" Background="{Binding StatusBackground}" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding StatusLabel}" FontSize="11" Foreground="{Binding StatusForeground}" />
                        </Border>
                        <TextBlock Text="{Binding TimestampText}" Classes="caption" HorizontalAlignment="Right" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </Grid>
    </StackPanel>
  </ScrollViewer>
</UserControl>
