<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProxyDock.App.ViewModels"
        x:Class="ProxyDock.App.Views.AppDiagnosticsDialog"
        x:DataType="vm:AppDiagnosticsViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://ProxyDock/Assets/proxydock.ico"
        Width="620"
        Height="600"
        MinWidth="460"
        MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <DockPanel Background="{DynamicResource AppCanvasBrush}">
    <Border DockPanel.Dock="Bottom"
            Padding="18,12"
            Background="{DynamicResource HeaderSurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{Binding Loc[DiagnosticsCopyReport]}"
                  Classes="secondary"
                  Command="{Binding CopyReportCommand}" />
          <TextBlock Text="{Binding Loc[DiagnosticsCopied]}"
                     FontSize="12"
                     Foreground="{DynamicResource SuccessBrush}"
                     IsVisible="{Binding CopiedToClipboard}"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="{Binding Loc[MenuEdit]}"
                  Classes="secondary"
                  IsVisible="{Binding CanEdit}"
                  Command="{Binding EditProfileCommand}" />
          <Button Content="{Binding Loc[BtnClose]}"
                  Classes="primary"
                  Command="{Binding CloseCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Padding="20,16" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding AppName}" Classes="page-title" />
            <TextBlock Text="{Binding LaunchKindLabel}" Classes="caption" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="{Binding Loc[DiagnosticsRefresh]}"
                  Classes="secondary"
                  Height="30"
                  Padding="12,0"
                  VerticalAlignment="Center"
                  Command="{Binding RefreshDiagnosticsCommand}" />
        </Grid>

        <!-- Сводка цели и стека -->
        <Border Classes="card">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Loc[DiagnosticsStackHeader]}" Classes="section-title" />
            <TextBlock Text="{Binding ResolvedTargetDisplay}"
                       Classes="mono"
                       TextWrapping="Wrap" />
            <WrapPanel ItemSpacing="8" LineSpacing="4">
              <Border Classes="pill" Background="{DynamicResource ElevatedSurfaceBrush}">
                <TextBlock Text="{Binding PackagingDisplay}" FontSize="11.5" />
              </Border>
              <Border Classes="pill" Background="{DynamicResource ElevatedSurfaceBrush}">
                <TextBlock Text="{Binding RuntimeStackDisplay}" FontSize="11.5" />
              </Border>
              <Border Classes="pill" Background="{DynamicResource AccentSoftBrush}">
                <TextBlock Text="{Binding ApplicabilityDisplay}"
                           FontSize="11.5"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource AccentBrush}" />
              </Border>
            </WrapPanel>
            <TextBlock Text="{Binding CompatibilitySummary}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding MsixInfoDisplay}"
                       IsVisible="{Binding HasMsixInfo}"
                       Classes="mono caption"
                       TextWrapping="Wrap" />
            <TextBlock Text="{Binding ProxySummary}"
                       FontSize="12"
                       FontWeight="Medium" />
            <TextBlock Text="{Binding StrategySummary}"
                       Classes="mono caption"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <!-- Примечания по архитектуре -->
        <Border Classes="card" IsVisible="{Binding HasCaveats}">
          <StackPanel Spacing="6">
            <TextBlock Text="{Binding Loc[DiagnosticsCaveatsHeader]}" Classes="section-title" />
            <ItemsControl ItemsSource="{Binding Caveats}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <TextBlock Text="{Binding}"
                             FontSize="12"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextWrapping="Wrap"
                             Margin="0,2" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Инспекция работающих процессов -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Loc[DiagnosticsProcessesHeader]}" Classes="section-title" />
            <TextBlock Text="{Binding ProcessDetectionSummary}"
                       FontSize="12"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding DetectedProcesses}" IsVisible="{Binding HasDetectedProcesses}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:DetectedProcessRowViewModel">
                  <Border Classes="list-row" Padding="8,6">
                    <StackPanel Spacing="2">
                      <WrapPanel ItemSpacing="8" LineSpacing="4">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12.5" />
                        <Border Classes="pill" Background="{DynamicResource ElevatedSurfaceBrush}">
                          <TextBlock Text="{Binding PidText}" Classes="mono" FontSize="11" />
                        </Border>
                        <Border Classes="pill" Background="{DynamicResource InfoSoftBrush}">
                          <TextBlock Text="{Binding RoleLabel}"
                                     FontSize="11"
                                     Foreground="{DynamicResource InfoBrush}" />
                        </Border>
                      </WrapPanel>
                      <TextBlock Text="{Binding DetailText}"
                                 IsVisible="{Binding HasDetail}"
                                 Classes="caption"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <!-- Последние запуски -->
        <Border Classes="card" IsVisible="{Binding HasRecentHistory}">
          <StackPanel Spacing="8">
            <TextBlock Text="{Binding Loc[DiagnosticsHistoryHeader]}" Classes="section-title" />
            <ItemsControl ItemsSource="{Binding RecentHistory}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:HistoryItemViewModel">
                  <Border Classes="list-row" Padding="8,6">
                    <StackPanel Spacing="3">
                      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <TextBlock Text="{Binding StatusLabel}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   Foreground="{Binding StatusForeground}" />
                        <TextBlock Grid.Column="1" Text="{Binding TimestampText}" Classes="caption" />
                      </Grid>
                      <TextBlock Text="{Binding Entry.Message}"
                                 FontSize="11.5"
                                 Foreground="{DynamicResource TextSecondaryBrush}"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding ProcessDetectionSummary}"
                                 IsVisible="{Binding HasProcessDetectionSummary}"
                                 FontSize="11.5"
                                 Foreground="{DynamicResource TextMutedBrush}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
