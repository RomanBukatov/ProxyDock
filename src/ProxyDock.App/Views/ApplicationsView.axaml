<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProxyDock.App.ViewModels"
             x:Class="ProxyDock.App.Views.ApplicationsView"
             x:DataType="vm:ApplicationsViewModel">
  <ScrollViewer Padding="28,24">
    <StackPanel Spacing="18" MaxWidth="1280">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Loc[AppsTitle]}" Classes="page-title" />
          <TextBlock Text="{Binding Loc[AppsDescription]}" Classes="page-desc" />
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
          <Button Content="{Binding Loc[BtnFromTemplate]}" Classes="secondary">
            <Button.Flyout>
              <MenuFlyout>
                <MenuItem Header="Desktop: Google Antigravity" Command="{Binding AddAntigravityTemplateCommand}" />
                <MenuItem Header="Desktop: Claude Desktop" Command="{Binding AddClaudeDesktopTemplateCommand}" />
                <MenuItem Header="Desktop: Codex Desktop" Command="{Binding AddCodexDesktopTemplateCommand}" />
                <Separator />
                <MenuItem Header="CLI (доп.): Claude Code" Command="{Binding AddClaudeCliTemplateCommand}" />
                <MenuItem Header="CLI (доп.): OpenAI Codex" Command="{Binding AddCodexCliTemplateCommand}" />
              </MenuFlyout>
            </Button.Flyout>
          </Button>
          <Button Content="+ CLI-программа" Classes="secondary" Command="{Binding AddCliApplicationCommand}" />
          <Button Content="{Binding Loc[BtnAddApp]}" Classes="primary" Command="{Binding AddDesktopApplicationCommand}" />
        </StackPanel>
      </Grid>

      <!-- Поиск и фильтр -->
      <Grid ColumnDefinitions="*,220" ColumnSpacing="12">
        <TextBox Text="{Binding SearchQuery}" PlaceholderText="{Binding Loc[SearchAppsPlaceholder]}" />
        <ComboBox Grid.Column="1" SelectedIndex="{Binding KindFilterIndex}" HorizontalAlignment="Stretch">
          <ComboBoxItem Content="{Binding Loc[FilterAll]}" />
          <ComboBoxItem Content="{Binding Loc[FilterDesktop]}" />
          <ComboBoxItem Content="{Binding Loc[FilterCli]}" />
        </ComboBox>
      </Grid>

      <Border Classes="card" IsVisible="{Binding !HasFilteredApps}">
        <StackPanel Spacing="8">
          <TextBlock Text="Приложений не найдено" FontWeight="SemiBold" />
          <TextBlock Text="Добавьте desktop-программу по .exe или выберите один из готовых профилей (Google Antigravity, Claude Desktop, Codex Desktop)."
                     Classes="caption"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding FilteredApps}" IsVisible="{Binding HasFilteredApps}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:AppCardViewModel">
            <Border Classes="card card-interactive" Margin="0,0,0,10">
              <Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="14">
                <Border Width="44" Height="44" CornerRadius="10" Background="{DynamicResource ElevatedSurfaceBrush}" VerticalAlignment="Top">
                  <Panel>
                    <Image Source="{Binding Icon}" Width="28" Height="28" IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    <TextBlock Text="APP" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                               IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}"
                               Foreground="{DynamicResource AccentBrush}" />
                  </Panel>
                </Border>

                <StackPanel Grid.Column="1" Spacing="5">
                  <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBlock Text="{Binding Name}" Classes="card-title" VerticalAlignment="Center" />
                    <Border Classes="pill" Background="{DynamicResource ElevatedSurfaceBrush}">
                      <TextBlock Text="{Binding KindLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" />
                    </Border>
                    <Border Classes="pill" Background="{DynamicResource AccentSoftBrush}" IsVisible="{Binding ShowChromiumBadge}">
                      <TextBlock Text="--proxy-server" FontSize="11" Foreground="{DynamicResource AccentBrush}" />
                    </Border>
                    <Border Classes="pill" Background="{Binding ApplicabilityBackground}">
                      <TextBlock Text="{Binding ApplicabilityBadge}" FontSize="11" FontWeight="SemiBold" Foreground="{Binding ApplicabilityForeground}" />
                    </Border>
                  </StackPanel>

                  <TextBlock Text="{Binding TargetDisplay}" Classes="mono caption" TextTrimming="CharacterEllipsis" />
                  <TextBlock Text="{Binding WorkingDirDisplay, StringFormat='Папка: {0}'}"
                             Classes="caption"
                             IsVisible="{Binding HasWorkingDir}"
                             TextTrimming="CharacterEllipsis" />

                  <TextBlock Text="{Binding CompatibilitySummary}"
                             FontSize="12"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             IsVisible="{Binding HasCompatibilitySummary}"
                             TextWrapping="Wrap" />

                  <TextBlock Text="Исполняемый файл или команда не найдены на этом ПК — проверьте путь в настройках профиля."
                             FontSize="12"
                             Foreground="{DynamicResource ErrorBrush}"
                             IsVisible="{Binding ShowMissingWarning}"
                             TextWrapping="Wrap" />

                  <StackPanel Orientation="Horizontal" Spacing="12" Margin="0,2,0,0">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Ellipse Width="8" Height="8" Fill="{Binding ProxyStatusDotBrush}" VerticalAlignment="Center" />
                      <TextBlock Text="{Binding AssignedProxyLabel}" FontSize="12.5" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastLaunchedText}" Classes="caption" VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                  <Button Content="Запустить" Classes="primary" Command="{Binding LaunchCommand}" />
                  <Button Content="Изменить" Classes="secondary" Command="{Binding EditCommand}" />
                  <Button Content="⋯" Classes="secondary" Padding="10,7">
                    <Button.Flyout>
                      <MenuFlyout>
                        <MenuItem Header="Запустить без прокси" Command="{Binding LaunchDirectCommand}" />
                        <MenuItem Header="Дублировать" Command="{Binding DuplicateCommand}" />
                        <MenuItem Header="Открыть папку" Command="{Binding OpenFolderCommand}" />
                        <Separator />
                        <MenuItem Header="Удалить" Command="{Binding DeleteCommand}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </StackPanel>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </StackPanel>
  </ScrollViewer>
</UserControl>
