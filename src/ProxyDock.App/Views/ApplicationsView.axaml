<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProxyDock.App.ViewModels"
             xmlns:controls="using:ProxyDock.App.Controls"
             x:Class="ProxyDock.App.Views.ApplicationsView"
             x:DataType="vm:ApplicationsViewModel">
  <ScrollViewer Padding="20,18" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="16">
      <!-- Компактная шапка лаунчера и выбор прокси по умолчанию -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
        <TextBlock Text="{Binding Loc[AppsTitle]}"
                   Classes="page-title"
                   VerticalAlignment="Center" />

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <ComboBox ItemsSource="{Binding AvailableProxies}"
                    SelectedItem="{Binding SelectedDefaultProxy}"
                    IsVisible="{Binding HasProxies}"
                    ToolTip.Tip="{Binding Loc[DefaultProxyLabel]}"
                    MinWidth="160"
                    MaxWidth="250"
                    MinHeight="32">
            <ComboBox.ItemTemplate>
              <DataTemplate x:DataType="vm:DefaultProxyOptionViewModel">
                <StackPanel Orientation="Horizontal" Spacing="7">
                  <Ellipse Width="6" Height="6" Fill="{Binding StatusDotBrush}" VerticalAlignment="Center" />
                  <TextBlock Text="{Binding Profile.Name}"
                             TextTrimming="CharacterEllipsis"
                             VerticalAlignment="Center" />
                </StackPanel>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <Button Content="{Binding Loc[BtnAddProxy]}"
                  Classes="secondary"
                  Height="32"
                  Padding="12,0"
                  IsVisible="{Binding !HasProxies}"
                  Command="{Binding AddNewProxyCommand}" />
        </StackPanel>
      </Grid>

      <!-- Поиск и компактный фильтр (показывается, когда есть приложения) -->
      <Grid ColumnDefinitions="*,Auto"
            IsVisible="{Binding HasAnyApps}">
        <TextBox Text="{Binding SearchQuery}"
                 PlaceholderText="{Binding Loc[SearchAppsPlaceholder]}" />
        <ComboBox Grid.Column="1"
                  Margin="8,0,0,0"
                  SelectedIndex="{Binding KindFilterIndex}"
                  MinWidth="110"
                  IsVisible="{Binding HasCliApps}">
          <ComboBoxItem Content="{Binding Loc[FilterAll]}" />
          <ComboBoxItem Content="{Binding Loc[FilterDesktop]}" />
          <ComboBoxItem Content="{Binding Loc[FilterCli]}" />
        </ComboBox>
      </Grid>

      <!-- Сообщение при отсутствии совпадений поиска -->
      <Border Classes="card" Padding="14,10" IsVisible="{Binding ShowNoSearchMatches}">
        <TextBlock Text="{Binding Loc[AppsNoMatches]}" Classes="caption" />
      </Border>

      <!-- Современная адаптивная сетка карточек приложений + карточка добавления -->
      <ItemsControl ItemsSource="{Binding GridItems}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:AdaptiveCardGridPanel MinColumnWidth="242"
                                            MaxColumns="4"
                                            ColumnSpacing="14"
                                            RowSpacing="14"
                                            MinCardHeight="170" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>

        <ItemsControl.DataTemplates>
          <!-- Карточка приложения -->
          <DataTemplate x:DataType="vm:AppCardViewModel">
            <Border Classes="app-card">
              <Grid RowDefinitions="Auto,*,Auto">
                <!-- Верх: иконка 44 DIP в аккуратном контейнере 48 DIP и компактное меню -->
                <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
                  <Border Width="48"
                          Height="48"
                          CornerRadius="12"
                          Background="{DynamicResource IconFrameBrush}"
                          BorderBrush="{DynamicResource IconFrameBorderBrush}"
                          BorderThickness="1"
                          ClipToBounds="True">
                    <Panel>
                      <Image Source="{Binding Icon}"
                             Width="44"
                             Height="44"
                             Stretch="Uniform"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             RenderOptions.BitmapInterpolationMode="HighQuality"
                             IsVisible="{Binding HasDesktopIcon}" />

                      <TextBlock Text="{Binding FirstLetter}"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding HasDesktopFallbackIcon}"
                                 Foreground="{DynamicResource AccentBrush}" />

                      <TextBlock Text="&gt;_"
                                 FontFamily="Cascadia Mono, Consolas, monospace"
                                 FontSize="16"
                                 FontWeight="Bold"
                                 HorizontalAlignment="Center"
                                 VerticalAlignment="Center"
                                 IsVisible="{Binding IsCli}"
                                 Foreground="{DynamicResource AccentBrush}" />
                    </Panel>
                  </Border>

                  <TextBlock Grid.Column="1" Text="{Binding RuntimeState}" IsVisible="{Binding IsDesktop}"
                             Margin="8,0" VerticalAlignment="Center" TextWrapping="Wrap"
                             FontSize="12" Foreground="{Binding StateBrush}" />
                  <Button Grid.Column="2"
                          Name="AppMoreMenuButton"
                          Content="⋯"
                          Classes="icon-btn"
                          VerticalAlignment="Top"
                          Click="OnAppMenuButtonClick"
                          ToolTip.Tip="{Binding Loc[BtnMoreActionsTooltip]}" />
                </Grid>

                <!-- Центр: полное название приложения без обрезания + название прокси -->
                <StackPanel Grid.Row="1"
                            Margin="0,12,0,14"
                            Spacing="4"
                            VerticalAlignment="Center">
                  <TextBlock Text="{Binding Name}"
                             Classes="app-card-title"
                             TextWrapping="Wrap" />


                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="6"
                             Height="6"
                             Fill="{Binding ProxyStatusDotBrush}"
                             IsVisible="{Binding ShowProxyDot}"
                             VerticalAlignment="Center" />
                    <TextBlock Text="{Binding SubtitleText}"
                               FontSize="12.5"
                               Foreground="{Binding SubtitleBrush}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="Center" />
                  </StackPanel>
                </StackPanel>

                <!-- Низ: крупная кнопка запуска (или отключённая + кнопка исправления пути) -->
                <Panel Grid.Row="2">
                  <Button Classes="launch-btn"
                          HorizontalAlignment="Stretch"
                          IsVisible="{Binding ShowLaunch}"
                          Command="{Binding LaunchCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                      <Path Data="M 1,0.5 L 9.5,5.5 L 1,10.5 Z"
                            Fill="{DynamicResource AccentTextOnFillBrush}"
                            Width="10"
                            Height="11"
                            VerticalAlignment="Center" />
                      <TextBlock Text="{Binding Loc[BtnLaunch]}" VerticalAlignment="Center" />
                    </StackPanel>
                  </Button>

                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6" IsVisible="{Binding ShowStop}">
                    <Button Classes="danger" HorizontalAlignment="Stretch" Height="36"
                            Content="{Binding Loc[MenuClose]}" Command="{Binding CloseCommand}" />
                    <Button Grid.Column="1" Classes="secondary" Width="36" Height="36" Padding="0"
                            AutomationProperties.Name="{Binding Loc[MenuRestart]}"
                            ToolTip.Tip="{Binding Loc[MenuRestart]}" Command="{Binding RestartCommand}">
                      <PathIcon Width="15" Height="15" Data="M12 4a8 8 0 1 0 7.9 9h-2a6 6 0 1 1-1.7-5.3L13 11h8V3l-3.3 3.3A8 8 0 0 0 12 4Z" />
                    </Button>
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto"
                        ColumnSpacing="8"
                        IsVisible="{Binding !TargetFound}">
                    <Button Classes="launch-btn"
                            HorizontalAlignment="Stretch"
                            Command="{Binding LaunchCommand}">
                      <TextBlock Text="{Binding Loc[BtnLaunch]}" VerticalAlignment="Center" />
                    </Button>
                    <Button Grid.Column="1"
                            Content="{Binding Loc[BtnFixPath]}"
                            Classes="secondary"
                            Height="36"
                            Padding="12,0"
                            Command="{Binding EditCommand}" />
                  </Grid>
                </Panel>
              </Grid>
            </Border>
          </DataTemplate>

          <!-- Карточка с плюсом для добавления нового приложения -->
          <DataTemplate x:DataType="vm:AddAppCardTileViewModel">
            <Button Classes="add-app-card">
              <Button.Flyout>
                <MenuFlyout Placement="BottomEdgeAlignedLeft"
                            PlacementConstraintAdjustment="FlipX, FlipY, SlideX, SlideY">
                  <MenuItem Header="{Binding Loc[MenuAddDesktop]}" Command="{Binding Parent.AddDesktopApplicationCommand}" />
                  <MenuItem Header="{Binding Loc[MenuAddCli]}" Command="{Binding Parent.AddCliApplicationCommand}" />
                  <Separator />
                  <MenuItem Header="{Binding Loc[MenuTemplatesHeader]}" IsEnabled="False" />
                  <MenuItem Header="Google Antigravity" Command="{Binding Parent.AddAntigravityTemplateCommand}" />
                  <MenuItem Header="Claude Desktop" Command="{Binding Parent.AddClaudeDesktopTemplateCommand}" />
                  <MenuItem Header="Codex Desktop" Command="{Binding Parent.AddCodexDesktopTemplateCommand}" />
                  <Separator />
                  <MenuItem Header="CLI: Claude Code" Command="{Binding Parent.AddClaudeCliTemplateCommand}" />
                  <MenuItem Header="CLI: OpenAI Codex" Command="{Binding Parent.AddCodexCliTemplateCommand}" />
                </MenuFlyout>
              </Button.Flyout>

              <StackPanel Spacing="9" HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border Width="44"
                        Height="44"
                        CornerRadius="12"
                        Background="{DynamicResource AccentSoftBrush}"
                        BorderBrush="{DynamicResource AccentBorderBrush}"
                        BorderThickness="1"
                        HorizontalAlignment="Center">
                  <Path Data="M 10,3 L 10,17 M 3,10 L 17,10"
                        Stroke="{DynamicResource AccentBrush}"
                        StrokeThickness="2"
                        StrokeLineCap="Round"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Border>

                <StackPanel Spacing="2" HorizontalAlignment="Center">
                  <TextBlock Text="{Binding Loc[AddAppCardTitle]}"
                             FontSize="13.5"
                             FontWeight="SemiBold"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextAlignment="Center"
                             TextWrapping="Wrap" />
                  <TextBlock Text="{Binding Loc[AddAppCardSubtitle]}"
                             FontSize="11.5"
                             Foreground="{DynamicResource TextMutedBrush}"
                             TextAlignment="Center"
                             TextWrapping="Wrap" />
                </StackPanel>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.DataTemplates>
      </ItemsControl>

      <!-- Автоматически обнаруженные приложения (скрывается, когда всё добавлено) -->
      <StackPanel Spacing="8" Margin="0,4,0,0" IsVisible="{Binding HasDetectedApps}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
          <TextBlock Text="{Binding Loc[DetectedAppsTitle]}"
                     Classes="section-title"
                     VerticalAlignment="Center" />
          <Button Grid.Column="1"
                  Content="{Binding Loc[AddAllDetected]}"
                  Classes="subtle"
                  Padding="9,4"
                  FontSize="12"
                  IsVisible="{Binding HasMultipleDetectedApps}"
                  Command="{Binding AddAllDetectedDesktopCommand}" />
        </Grid>

        <Border Classes="surface-list">
          <ItemsControl Classes="row-list" ItemsSource="{Binding DetectedApps}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DetectedAppItemViewModel">
                <Border Classes="list-row" Padding="14,9">
                  <Grid ColumnDefinitions="36,*,Auto" ColumnSpacing="12">
                    <Border Width="36"
                            Height="36"
                            CornerRadius="9"
                            Background="{DynamicResource IconFrameBrush}"
                            BorderBrush="{DynamicResource IconFrameBorderBrush}"
                            BorderThickness="1"
                            VerticalAlignment="Center">
                      <Panel>
                        <Image Source="{Binding Icon}"
                               Width="30"
                               Height="30"
                               Stretch="Uniform"
                               RenderOptions.BitmapInterpolationMode="HighQuality"
                               IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNotNull}}" />
                        <TextBlock Text="+"
                                   FontSize="14"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsVisible="{Binding Icon, Converter={x:Static ObjectConverters.IsNull}}"
                                   Foreground="{DynamicResource AccentBrush}" />
                      </Panel>
                    </Border>

                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="1">
                      <TextBlock Text="{Binding Name}"
                                 Classes="row-title"
                                 TextWrapping="Wrap" />
                      <TextBlock Text="{Binding Loc[DetectedOnPc]}" Classes="caption" />
                    </StackPanel>

                    <Button Grid.Column="2"
                            Content="{Binding Loc[BtnAddDetected]}"
                            Classes="secondary"
                            MinWidth="88"
                            Height="30"
                            Padding="12,0"
                            VerticalAlignment="Center"
                            Command="{Binding AddCommand}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Border>
      </StackPanel>
    </StackPanel>
  </ScrollViewer>
</UserControl>
