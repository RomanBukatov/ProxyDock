<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:ProxyDock.App.ViewModels"
             x:Class="ProxyDock.App.Views.ProxyProfilesView"
             x:DataType="vm:ProxyProfilesViewModel">
  <ScrollViewer Padding="20,18" HorizontalScrollBarVisibility="Disabled">
    <StackPanel Spacing="14">
      <!-- Заголовок и действия -->
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="{Binding Loc[ProxiesTitle]}"
                   Classes="page-title"
                   VerticalAlignment="Center" />
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8"
                    VerticalAlignment="Center">
          <Button Content="{Binding Loc[BtnTestAll]}"
                  Classes="secondary"
                  Height="32"
                  Padding="12,0"
                  IsVisible="{Binding HasProxies}"
                  Command="{Binding TestAllCommand}" />
          <Button Content="{Binding Loc[BtnAddProxy]}"
                  Classes="primary"
                  Height="32"
                  Padding="14,0"
                  Command="{Binding AddProxyCommand}" />
        </StackPanel>
      </Grid>

      <!-- Пустой список -->
      <Border Classes="card" Padding="14" IsVisible="{Binding !HasProxies}">
        <StackPanel Spacing="4">
          <TextBlock Text="{Binding Loc[ProxiesEmptyTitle]}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding Loc[ProxiesEmptySubtitle]}" Classes="caption" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!-- Список прокси-профилей -->
      <Border Classes="surface-list" IsVisible="{Binding HasProxies}">
        <ItemsControl Classes="row-list" ItemsSource="{Binding Proxies}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ProxyCardViewModel">
              <Border Classes="list-row">
                <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
                  <StackPanel Grid.Column="0"
                              MinWidth="160"
                              VerticalAlignment="Center"
                              Spacing="3">
                    <WrapPanel Orientation="Horizontal" ItemSpacing="6" LineSpacing="4">
                      <TextBlock Text="{Binding Name}"
                                 Classes="row-title"
                                 VerticalAlignment="Center" />
                      <Border Classes="pill"
                              Background="{DynamicResource AccentSoftBrush}"
                              IsVisible="{Binding IsDefault}">
                        <TextBlock Text="{Binding Loc[DefaultBadge]}"
                                   FontSize="11"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                      </Border>
                      <TextBlock Text="{Binding AuthBadgeText}"
                                 Classes="caption"
                                 IsVisible="{Binding HasAuth}"
                                 VerticalAlignment="Center" />
                    </WrapPanel>

                    <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6">
                      <Ellipse Width="7"
                               Height="7"
                               Fill="{Binding StatusDotBrush}"
                               VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding StatusLabel}"
                                 FontSize="12"
                                 FontWeight="Medium"
                                 Foreground="{Binding StatusForeground}"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2"
                                 Text="·"
                                 Classes="caption"
                                 VerticalAlignment="Center" />
                      <TextBlock Grid.Column="3"
                                 Text="{Binding MetricsDisplay}"
                                 Classes="mono caption"
                                 TextTrimming="CharacterEllipsis"
                                 VerticalAlignment="Center" />
                    </Grid>

                    <TextBlock Text="{Binding StatusMessage}"
                               Classes="caption"
                               TextWrapping="Wrap"
                               IsVisible="{Binding HasStatusDetail}" />
                  </StackPanel>

                  <Button Grid.Column="1"
                          Content="{Binding TestButtonText}"
                          Classes="secondary"
                          MinWidth="88"
                          Height="30"
                          Padding="12,0"
                          VerticalAlignment="Center"
                          Command="{Binding TestOrCancelCommand}" />

                  <Button Grid.Column="2"
                          Content="⋯"
                          Classes="icon-btn"
                          VerticalAlignment="Center"
                          ToolTip.Tip="{Binding Loc[BtnMoreActionsTooltip]}">
                    <Button.Flyout>
                      <MenuFlyout Placement="BottomEdgeAlignedRight"
                                  PlacementConstraintAdjustment="FlipX, FlipY, SlideX, SlideY">
                        <MenuItem Header="{Binding Loc[BtnSetDefault]}"
                                  IsVisible="{Binding !IsDefault}"
                                  Command="{Binding SetDefaultCommand}" />
                        <MenuItem Header="{Binding Loc[BtnEdit]}" Command="{Binding EditCommand}" />
                        <MenuItem Header="{Binding Loc[BtnDuplicate]}" Command="{Binding DuplicateCommand}" />
                        <Separator />
                        <MenuItem Header="{Binding Loc[BtnDelete]}" Command="{Binding DeleteCommand}" />
                      </MenuFlyout>
                    </Button.Flyout>
                  </Button>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
