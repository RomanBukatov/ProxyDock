<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProxyDock.App.ViewModels"
        xmlns:views="using:ProxyDock.App.Views"
        x:Class="ProxyDock.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Loc[AppTitle]}"
        Icon="avares://ProxyDock/Assets/proxydock.ico"
        Width="1200"
        Height="780"
        MinWidth="900"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
  <Grid ColumnDefinitions="246,*">
    <!-- Боковая панель навигации -->
    <Border Grid.Column="0"
            Background="{DynamicResource SidebarSurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,1,0"
            Padding="16,20">
      <DockPanel>
        <!-- Логотип и название -->
        <StackPanel DockPanel.Dock="Top" Spacing="14" Margin="4,0,4,22">
          <StackPanel Orientation="Horizontal" Spacing="10">
            <Border Width="34" Height="34" CornerRadius="9" Background="{DynamicResource AccentSoftBrush}">
              <TextBlock Text="PD"
                         FontWeight="Bold"
                         FontSize="14"
                         Foreground="{DynamicResource AccentBrush}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
            </Border>
            <StackPanel VerticalAlignment="Center">
              <TextBlock Text="{Binding Loc[AppTitle]}" FontSize="17" FontWeight="Bold" />
              <TextBlock Text="{Binding Loc[AppSubtitle]}" Classes="caption" />
            </StackPanel>
          </StackPanel>
        </StackPanel>

        <!-- Нижние статусные карточки -->
        <StackPanel DockPanel.Dock="Bottom" Spacing="10">
          <Border Classes="card" Padding="12" Background="{DynamicResource ElevatedSurfaceBrush}">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding Loc[DefaultProxyLabel]}" Classes="caption" />
              <TextBlock Text="{Binding DefaultProxyText}"
                         FontSize="12.5"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>

          <Border Classes="card" Padding="10,8" Background="{DynamicResource SuccessSoftBrush}" BorderBrush="{DynamicResource SuccessBrush}">
            <TextBlock Text="{Binding Loc[SystemProxyUnchangedBadge]}"
                       FontSize="11.5"
                       FontWeight="Medium"
                       Foreground="{DynamicResource SuccessBrush}"
                       TextWrapping="Wrap" />
          </Border>
        </StackPanel>

        <!-- Кнопки навигации -->
        <StackPanel Spacing="4">
          <RadioButton Classes="nav-item"
                       GroupName="MainNav"
                       IsChecked="{Binding IsDashboardSelected}"
                       Content="{Binding Loc[NavDashboard]}" />
          <RadioButton Classes="nav-item"
                       GroupName="MainNav"
                       IsChecked="{Binding IsApplicationsSelected}"
                       Content="{Binding Loc[NavApplications]}" />
          <RadioButton Classes="nav-item"
                       GroupName="MainNav"
                       IsChecked="{Binding IsProxiesSelected}"
                       Content="{Binding Loc[NavProxies]}" />
          <RadioButton Classes="nav-item"
                       GroupName="MainNav"
                       IsChecked="{Binding IsHistorySelected}"
                       Content="{Binding Loc[NavHistory]}" />
          <RadioButton Classes="nav-item"
                       GroupName="MainNav"
                       IsChecked="{Binding IsSettingsSelected}"
                       Content="{Binding Loc[NavSettings]}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Рабочая область -->
    <DockPanel Grid.Column="1" Background="{DynamicResource AppCanvasBrush}">
      <!-- Баннер уведомлений и предупреждений -->
      <Border DockPanel.Dock="Top"
              Margin="24,16,24,0"
              Padding="14,10"
              CornerRadius="10"
              BorderThickness="1"
              Background="{Binding BannerBackground}"
              BorderBrush="{Binding BannerBorder}"
              IsVisible="{Binding BannerVisible}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
          <StackPanel Spacing="2">
            <TextBlock Text="{Binding BannerTitle}" FontWeight="SemiBold" />
            <TextBlock Text="{Binding BannerMessage}"
                       FontSize="12.5"
                       Foreground="{DynamicResource TextSecondaryBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
          <Button Grid.Column="1"
                  Content="✕"
                  Classes="subtle"
                  VerticalAlignment="Top"
                  Command="{Binding DismissBannerCommand}" />
        </Grid>
      </Border>

      <ContentControl Content="{Binding CurrentPage}">
        <ContentControl.DataTemplates>
          <DataTemplate DataType="vm:DashboardViewModel">
            <views:DashboardView />
          </DataTemplate>
          <DataTemplate DataType="vm:ApplicationsViewModel">
            <views:ApplicationsView />
          </DataTemplate>
          <DataTemplate DataType="vm:ProxyProfilesViewModel">
            <views:ProxyProfilesView />
          </DataTemplate>
          <DataTemplate DataType="vm:LaunchHistoryViewModel">
            <views:LaunchHistoryView />
          </DataTemplate>
          <DataTemplate DataType="vm:SettingsViewModel">
            <views:SettingsView />
          </DataTemplate>
        </ContentControl.DataTemplates>
      </ContentControl>
    </DockPanel>
  </Grid>
</Window>
