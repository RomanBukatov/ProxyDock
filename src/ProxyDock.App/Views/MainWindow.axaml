<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProxyDock.App.ViewModels"
        xmlns:views="using:ProxyDock.App.Views"
        x:Class="ProxyDock.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Loc[AppTitle]}"
        Icon="avares://ProxyDock/Assets/proxydock.ico"
        Width="820"
        Height="580"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterScreen">
  <DockPanel Background="{DynamicResource AppCanvasBrush}">
    <!-- Компактная верхняя навигация -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource HeaderSurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,0,0,1"
            Padding="14,7">
      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="14">
        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Border Width="24" Height="24" CornerRadius="6" Background="{DynamicResource AccentSoftBrush}">
            <TextBlock Text="PD"
                       FontWeight="Bold"
                       FontSize="11"
                       Foreground="{DynamicResource AccentBrush}"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center" />
          </Border>
          <TextBlock Text="{Binding Loc[AppTitle]}"
                     FontSize="14"
                     FontWeight="SemiBold"
                     VerticalAlignment="Center" />
        </StackPanel>

        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="2"
                    VerticalAlignment="Center">
          <RadioButton Classes="nav-tab"
                       GroupName="MainNav"
                       IsChecked="{Binding IsApplicationsSelected}"
                       Content="{Binding Loc[NavApplications]}" />
          <RadioButton Classes="nav-tab"
                       GroupName="MainNav"
                       IsChecked="{Binding IsProxiesSelected}"
                       Content="{Binding Loc[NavProxies]}" />
          <RadioButton Classes="nav-tab"
                       GroupName="MainNav"
                       IsChecked="{Binding IsHistorySelected}"
                       Content="{Binding Loc[NavHistory]}" />
          <RadioButton Classes="nav-tab"
                       GroupName="MainNav"
                       IsChecked="{Binding IsSettingsSelected}"
                       Content="{Binding Loc[NavSettings]}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Тонкая строка состояния -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource HeaderSurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0"
            Padding="14,5">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Ellipse Width="6" Height="6" Fill="{DynamicResource SuccessBrush}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding Loc[SystemProxyUnchangedShort]}"
                     FontSize="11.5"
                     Foreground="{DynamicResource TextMutedBrush}"
                     TextTrimming="CharacterEllipsis"
                     VerticalAlignment="Center" />
        </StackPanel>
        <TextBlock Grid.Column="1"
                   Text="{Binding Loc[TrayActiveBadge]}"
                   FontSize="11.5"
                   Foreground="{DynamicResource AccentBrush}"
                   IsVisible="{Binding IsTrayEnabled}"
                   VerticalAlignment="Center" />
      </Grid>
    </Border>

    <!-- Баннер уведомлений и предупреждений -->
    <Border DockPanel.Dock="Top"
            Margin="16,10,16,0"
            Padding="12,8"
            CornerRadius="6"
            BorderThickness="1"
            Background="{Binding BannerBackground}"
            BorderBrush="{Binding BannerBorder}"
            IsVisible="{Binding BannerVisible}">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <StackPanel Spacing="1">
          <TextBlock Text="{Binding BannerTitle}" FontSize="12.5" FontWeight="SemiBold" />
          <TextBlock Text="{Binding BannerMessage}"
                     FontSize="12"
                     Foreground="{DynamicResource TextSecondaryBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
        <Button Grid.Column="1"
                Content="✕"
                Classes="icon-btn"
                Width="26"
                Height="26"
                FontSize="12"
                VerticalAlignment="Top"
                Command="{Binding DismissBannerCommand}" />
      </Grid>
    </Border>

    <!-- Рабочая область -->
    <ContentControl Content="{Binding CurrentPage}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="vm:ApplicationsViewModel">
          <views:ApplicationsView />
        </DataTemplate>
        <DataTemplate DataType="vm:ProxyProfilesViewModel">
          <views:ProxyProfilesView />
        </DataTemplate>
        <DataTemplate DataType="vm:LaunchHistoryViewModel">
          <views:LaunchHistoryView />
        </DataTemplate>
        <DataTemplate DataType="vm:SettingsViewModel">
          <views:SettingsView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </DockPanel>
</Window>
