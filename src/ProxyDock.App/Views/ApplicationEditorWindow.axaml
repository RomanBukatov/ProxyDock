<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ProxyDock.App.ViewModels"
        xmlns:models="using:ProxyDock.Core.Models"
        x:Class="ProxyDock.App.Views.ApplicationEditorWindow"
        x:DataType="vm:ApplicationEditorViewModel"
        Title="{Binding WindowTitle}"
        Icon="avares://ProxyDock/Assets/proxydock.ico"
        Width="640"
        Height="640"
        MinWidth="460"
        MinHeight="440"
        WindowStartupLocation="CenterOwner">
  <DockPanel Background="{DynamicResource AppCanvasBrush}">
    <Border DockPanel.Dock="Bottom"
            Padding="18,12"
            Background="{DynamicResource HeaderSurfaceBrush}"
            BorderBrush="{DynamicResource BorderSubtleBrush}"
            BorderThickness="0,1,0,0">
      <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
        <TextBlock Text="Настройки окружения применяются только к дочернему процессу."
                   Classes="caption"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
          <Button Content="Отмена" Classes="secondary" Command="{Binding CancelCommand}" />
          <Button Content="Сохранить" Classes="primary" Command="{Binding SaveCommand}" />
        </StackPanel>
      </Grid>
    </Border>

    <ScrollViewer Padding="20,16" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="12">
        <TextBlock Text="{Binding WindowTitle}" Classes="page-title" />

        <Grid ColumnDefinitions="1.4*,*" ColumnSpacing="10">
          <StackPanel Spacing="5">
            <TextBlock Text="Название приложения *" FontWeight="Medium" />
            <TextBox Text="{Binding Name}" PlaceholderText="Например: Google Antigravity или Claude Desktop" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="Тип запуска" FontWeight="Medium" />
            <ComboBox SelectedIndex="{Binding LaunchKindIndex}" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Desktop GUI (.exe)" />
              <ComboBoxItem Content="CLI (терминал)" />
            </ComboBox>
          </StackPanel>
        </Grid>

        <StackPanel Spacing="5">
          <TextBlock Text="{Binding TargetFieldLabel}" FontWeight="Medium" />
          <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding ExecutableOrCommand}" PlaceholderText="{Binding TargetWatermark}" />
            <Button Grid.Column="1" Content="Обзор..." Classes="secondary" Command="{Binding BrowseExecutableCommand}" />
            <Button Grid.Column="2" Content="Проверить" Classes="secondary" Command="{Binding InspectCurrentTargetCommand}" />
          </Grid>

          <!-- Техническая диагностика стека (MSIX / Electron / Chromium / WebView2 / путь) -->
          <Border Classes="card" Background="{DynamicResource ElevatedSurfaceBrush}" Margin="0,2,0,0">
            <StackPanel Spacing="5">
              <TextBlock Text="Диагностика стека и совместимость" FontSize="12.5" FontWeight="SemiBold" />
              <TextBlock Text="{Binding DiscoverySummary}"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding StackCaveatsText}"
                         IsVisible="{Binding HasStackCaveats}"
                         FontSize="12"
                         Foreground="{DynamicResource WarningBrush}"
                         TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>

        <StackPanel Spacing="5">
          <TextBlock Text="Рабочая директория (опционально)" FontWeight="Medium" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <TextBox Text="{Binding WorkingDirectory}" PlaceholderText="По умолчанию — папка .exe или папка проекта" />
            <Button Grid.Column="1" Content="Папка..." Classes="secondary" Command="{Binding BrowseWorkingDirectoryCommand}" />
          </Grid>
        </StackPanel>

        <StackPanel Spacing="5">
          <TextBlock Text="Дополнительные аргументы командной строки" FontWeight="Medium" />
          <TextBox Text="{Binding Arguments}" PlaceholderText="Например: --profile work" />
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
          <StackPanel Spacing="5">
            <TextBlock Text="Режим прокси" FontWeight="Medium" />
            <ComboBox SelectedIndex="{Binding ProxyModeIndex}" HorizontalAlignment="Stretch">
              <ComboBoxItem Content="Прокси по умолчанию" />
              <ComboBoxItem Content="Выбранный прокси" />
              <ComboBoxItem Content="Без прокси (напрямую)" />
            </ComboBox>
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5" IsVisible="{Binding ShowSpecificProxyPicker}">
            <TextBlock Text="Профиль прокси *" FontWeight="Medium" />
            <ComboBox ItemsSource="{Binding AvailableProxies}"
                      SelectedItem="{Binding SelectedProxy}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="models:ProxyProfile">
                  <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Grid>

        <!-- Секция Desktop GUI -->
        <Border Classes="card" IsVisible="{Binding IsDesktopMode}">
          <StackPanel Spacing="8">
            <TextBlock Text="Параметры Desktop GUI" FontWeight="SemiBold" />
            <CheckBox Content="Передавать флаг Chromium/Electron (--proxy-server=http://host:port)"
                      IsChecked="{Binding UseChromiumProxyFlag}" />
            <TextBlock Text="Включайте только для Electron/Chromium-приложений (например, Google Antigravity). Пароль в аргументы запуска не подставляется."
                       Classes="caption"
                       TextWrapping="Wrap" />

            <Border Classes="card"
                    Padding="10"
                    Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    IsVisible="{Binding ShowAuthChromiumWarning}">
              <TextBlock Text="Выбранный прокси требует авторизацию, а флаг Chromium `--proxy-server` не передаёт логин и пароль автоматически."
                         FontSize="12"
                         Foreground="{DynamicResource WarningBrush}"
                         TextWrapping="Wrap" />
            </Border>

            <Border Classes="card"
                    Padding="10"
                    Background="{DynamicResource WarningSoftBrush}"
                    BorderBrush="{DynamicResource WarningBrush}"
                    IsVisible="{Binding ShowNonChromiumFlagWarning}">
              <TextBlock Text="Для указанного исполняемого файла не подтверждён стек Electron/Chromium — флаг `--proxy-server` может не сработать."
                         FontSize="12"
                         Foreground="{DynamicResource WarningBrush}"
                         TextWrapping="Wrap" />
            </Border>

            <StackPanel Spacing="4">
              <TextBlock Text="Связанные имена процессов (через запятую)"
                         FontSize="12"
                         Foreground="{DynamicResource TextSecondaryBrush}" />
              <TextBox Text="{Binding RelatedProcessNamesText}" PlaceholderText="Например: Claude или ChatGPT, Codex" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!-- Секция CLI -->
        <Border Classes="card" IsVisible="{Binding IsCliMode}">
          <StackPanel Spacing="8">
            <TextBlock Text="Параметры CLI-терминала" FontWeight="SemiBold" />
            <CheckBox Content="Запускать в отдельном интерактивном терминале" IsChecked="{Binding LaunchInTerminal}" />
            <CheckBox Content="Не закрывать терминал после завершения команды (-NoExit)"
                      IsChecked="{Binding KeepTerminalOpen}"
                      IsEnabled="{Binding LaunchInTerminal}" />
            <StackPanel Spacing="5">
              <TextBlock Text="Терминал для этого профиля" FontSize="12" />
              <ComboBox SelectedIndex="{Binding TerminalOverrideIndex}" HorizontalAlignment="Stretch">
                <ComboBoxItem Content="Как в общих настройках" />
                <ComboBoxItem Content="Windows Terminal (wt.exe)" />
                <ComboBoxItem Content="Windows PowerShell" />
                <ComboBoxItem Content="PowerShell 7 (pwsh)" />
              </ComboBox>
            </StackPanel>
          </StackPanel>
        </Border>

        <StackPanel Spacing="5">
          <TextBlock Text="Переопределение NO_PROXY (опционально)" FontWeight="Medium" />
          <TextBox Text="{Binding NoProxyOverride}" PlaceholderText="Оставьте пустым для использования NO_PROXY из профиля прокси" />
        </StackPanel>

        <!-- Дополнительные переменные окружения -->
        <Border Classes="card">
          <StackPanel Spacing="8">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
              <TextBlock Text="Дополнительные переменные окружения"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center" />
              <Button Grid.Column="1"
                      Content="+ Переменная"
                      Classes="secondary"
                      Command="{Binding AddEnvVarCommand}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding EnvironmentVariables}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:EnvVarRowViewModel">
                  <Grid ColumnDefinitions="*,1.3*,Auto,Auto" ColumnSpacing="8" Margin="0,3">
                    <TextBox Text="{Binding Key}" PlaceholderText="КЛЮЧ" />
                    <TextBox Grid.Column="1" Text="{Binding Value}" PlaceholderText="Значение" />
                    <CheckBox Grid.Column="2" Content="Секрет" IsChecked="{Binding IsSecret}" VerticalAlignment="Center" />
                    <Button Grid.Column="3"
                            Content="✕"
                            Classes="icon-btn"
                            Command="{Binding RemoveCommand}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>

        <StackPanel Spacing="5">
          <TextBlock Text="Заметки (опционально)" FontWeight="Medium" />
          <TextBox Text="{Binding Notes}" AcceptsReturn="True" Height="58" TextWrapping="Wrap" />
        </StackPanel>

        <Border Classes="card"
                Background="{DynamicResource ErrorSoftBrush}"
                BorderBrush="{DynamicResource ErrorBrush}"
                IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
          <TextBlock Text="{Binding ValidationError}"
                     Foreground="{DynamicResource ErrorBrush}"
                     TextWrapping="Wrap" />
        </Border>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</Window>
