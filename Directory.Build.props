<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Deterministic>true</Deterministic>
    <Company>ProxyDock</Company>
    <Product>ProxyDock</Product>
    <Authors>ProxyDock Contributors</Authors>
    <Description>Windows 11 Desktop HTTP Proxy Launcher</Description>
    <Copyright>Copyright © 2026 ProxyDock</Copyright>
    <ProxyDockVersion Condition="'$(ProxyDockVersion)' == ''">0.1.1</ProxyDockVersion>
    <_ProxyDockCoreVersion>$([System.String]::Copy('$(ProxyDockVersion)').Split('-')[0])</_ProxyDockCoreVersion>
    <Version>$(ProxyDockVersion)</Version>
    <AssemblyVersion>$(_ProxyDockCoreVersion).0</AssemblyVersion>
    <FileVersion>$(_ProxyDockCoreVersion).0</FileVersion>
    <InformationalVersion>$(ProxyDockVersion)</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
  </PropertyGroup>
</Project>
